<Project>

  <Import Project="Version.Details.props" />

  <PropertyGroup Label="Version settings">
    <VersionPrefix>11.0.0</VersionPrefix>
    <PreReleaseVersionLabel>rtm</PreReleaseVersionLabel>
    <PreReleaseVersionIteration></PreReleaseVersionIteration>
    <!-- Allowed values: '', 'prerelease', 'release'. Set to 'release' when stabilizing. -->
    <DotNetFinalVersionKind></DotNetFinalVersionKind>

    <IncludeSourceRevisionInInformationalVersion>False</IncludeSourceRevisionInInformationalVersion>

    <!-- Arcade features -->
    <UsingToolXliff>false</UsingToolXliff>

    <!-- For an LTS release EF design tools only support the current TFM, but the corresponding Roslyn build might only become available after RTM. -->
    <ShouldUseLiveRoslyn Condition="'$(PreReleaseVersionLabel)' == 'servicing' And !$(VersionPrefix.EndsWith('.0')) And !$(VersionPrefix.EndsWith('.1'))">true</ShouldUseLiveRoslyn>

    <!--
      Upper bound for NuGet dependency version ranges on packages built from this repo.
      Calculated as (major+1).0.0-a, where the -a pre-release suffix ensures that pre-release
      versions of the next major (like 12.0.0-preview1) are excluded, since in NuGet SemVer 2.0
      ordering 12.0.0-preview1 > 12.0.0-a. Note that NuGet requires the numeric portion of a
      pre-release label to not start with 0, so a non-numeric label is used here.
    -->
    <NextMajorVersion>$([MSBuild]::Add($([System.Version]::Parse('$(VersionPrefix)').Major), 1)).0.0-a</NextMajorVersion>
  </PropertyGroup>

  <PropertyGroup Label="MSBuild and Roslyn">
    <MicrosoftBuildFrameworkVersion>18.9.6</MicrosoftBuildFrameworkVersion>
    <MicrosoftBuildUtilitiesCoreVersion>18.9.6</MicrosoftBuildUtilitiesCoreVersion>
    <MicrosoftBuildTasksCoreVersion>18.9.6</MicrosoftBuildTasksCoreVersion>
    <MicrosoftCodeAnalysisCSharpVersion>5.9.0</MicrosoftCodeAnalysisCSharpVersion>
    <MicrosoftCodeAnalysisCSharpWorkspacesVersion>5.9.0</MicrosoftCodeAnalysisCSharpWorkspacesVersion>
    <MicrosoftCodeAnalysisWorkspacesMSBuildVersion>5.9.0</MicrosoftCodeAnalysisWorkspacesMSBuildVersion>
  </PropertyGroup>

  <PropertyGroup Label="Test dependencies">
    <MicrosoftCodeAnalysisAnalyzerTestingVersion>1.1.4</MicrosoftCodeAnalysisAnalyzerTestingVersion>
    <MicrosoftCodeAnalysisCSharpTestingVersion>1.1.4</MicrosoftCodeAnalysisCSharpTestingVersion>
    <AzureIdentityVersion>1.21.0</AzureIdentityVersion>
    <AzureResourceManagerCosmosDBVersion>1.5.0</AzureResourceManagerCosmosDBVersion>
    <OpenTelemetryExporterInMemoryVersion>1.19.0</OpenTelemetryExporterInMemoryVersion>
    <SQLitePCLRawVersion>3.0.5</SQLitePCLRawVersion>
    <SQLite3MCPCLRawBundleVersion>2.4.0</SQLite3MCPCLRawBundleVersion>
    <XUnitV3Version>4.0.0-pre.108</XUnitV3Version>
    <MicrosoftDotNetXUnitV3ExtensionsVersion>11.0.0-beta.26467.112</MicrosoftDotNetXUnitV3ExtensionsVersion>
    <MicrosoftTestingPlatformVersion>2.4.1</MicrosoftTestingPlatformVersion>
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.11.2</MicrosoftTestingExtensionsCodeCoverageVersion>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <StyleCopAnalyzersVersion>1.1.118</StyleCopAnalyzersVersion>
    <DotNetAnalyzersDocumentationAnalyzersVersion>1.0.0-beta.59</DotNetAnalyzersDocumentationAnalyzersVersion>
  </PropertyGroup>

  <PropertyGroup Label="Tooling dependencies">
    <ICSharpCodeDecompilerVersion>10.1.1.8388</ICSharpCodeDecompilerVersion>
    <SystemCommandLineVersion>2.0.12</SystemCommandLineVersion>
  </PropertyGroup>

</Project>
